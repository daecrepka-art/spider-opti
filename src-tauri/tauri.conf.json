{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spider-Opti",
  "version": "0.1.0",
  "identifier": "com.spideropti.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spider-Opti",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": true,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
